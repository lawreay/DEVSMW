# Set the external search engine to use DuckDuckGo (free, no API key required).
SEARCH_ENGINE=duckduckgo

# Replace with your actual Bing search API key (optional - for Bing search).
BING_SEARCH_KEY=your_real_bing_search_key_here

# Optional GitHub token for higher rate limits.
GITHUB_TOKEN=your_github_token_here
